#file transfer
#sftp is a secure file transfer protocol programme that is similar to ftp.
#sftp performs all actions over an encrypted ssh transport.
#start session with 
sftp username@serv1 // server1 external ip

#sftp commands
cd dir // change directory on the ftp server to dir
lcd dir // same operation but on client
ls // list files in the current directory on the ftp server
lls // same operation but on client
pwd // prints current directory on the ftp server
lpwd // same operation on the client
get file // download the file from the ftp server to current firectory
put file // upload the file from your machine to the ftp server
exit // exits from the sftp programme
mput files // uploads multiple files 
mput *.log // all .log files in server working directory
mget files // similar to mput but for downloads

