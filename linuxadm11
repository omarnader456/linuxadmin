# the -exec feature of the find command is really powerful.
#-exec tells find to execute the command that follows instead of just printing the file
# paths.
find [path] [conditions] -exec [command] {} \;
#the curl braces '{}' are placeholders that find replaces with full path of each matched
# file
# the backslash semicolon '\;\ marks the end of the -exec command (can also use plus '+').
#the '\;' stops the shell from interpreting ; as the end of the line 
#\; runs once per file, while + groups all matched files into a single command

#lsof prints detailed information about open files, including command name, PID
#, user, and file descriptor 

find [path] [conditions] -exec lsof {} + 2>/dev/null
#this passes all matched files to lsof, which is faster than running lsof separately 
#for every file

find / -type f -size +500M -exec lsof {} + 2>/dev/null
#-size for file size, and +500M for files larger than 500 MB
#-type f for searching regular files
#-type d for directories
#-type l for symbolic links (symlinks pointing to other files or folders)
#-type s sockets
#-type p pipes used for processing data between processes
#-type b/c device files b for block devices (like hard drives) and c for character devices 
#(like terminals)

#fuser is a faster more minimal version of lsof - its default option only shows PIDs
# using a file; it contains built in flags to kill those processes
#-v for verbose output in table format
#-k kills processes holding files
#-i add to -k (-ki) makes fuser ask for permission before killing each process
 
