#find command searches directories that match somecommand
find /var -name access.log
#the command searches in /var dir for files matching access.log
find /home -mtime -3
#searches /home dir for files last-modified in the last 3 days.
#-mtime for days
# +n for more than n days
# -n for less than n days
# n for ndays
#use -mmin for minutes
#use -delete to delete files matching the condition
#-print to print files, show files before you try to delete anything first
#also find uses permissions, so consider using sudo before find if permission of user is
#enough

find /var -name access.log 2>&1 | grep -vi "Permission denied"
#the command filters for access.log in the /var dir, then redirects standerd error output
#to standeredout. 
#0 file descriptor for standard input
#1 file descriptor for standered output
#2 file descriptor for standard error
# 1 needs the ampersign '&' because the redirection operator expects a descriptor 
#as input and file as destination, so we can leave 2 without &, but
# without an ampersign, the output would be sent to a file named 1, the ampersand acts
#like a pointer to the file descriptor number 1.
#grep -vi "Permission denied" filters output based on the literal text argument
#-v inverts the match (so everything not matching the literal string
#-i makes search case insensitive

#grep -R searches recursively down a directory structure, even following symbolic links
