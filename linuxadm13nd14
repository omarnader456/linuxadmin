#getent is a command that retrieves entries from databases managed by the name service 
#switch. It provides a unified way to query system information such as users, groups,
#hosts, and services from local files or network sources like LDAP. unlike directly reading 
#from files such as /etc/passwd, getent queries the same sources the system uses, 
#ensuring accurate and complete results. 

getent passwd 
#displays all users available on the system. Queries the passwd database and lists all users
#from local files and network services like LDAP

#fetch info for specific user 
getent passwd <user-name>

#fetch all groups configured on the system
getent group

getent [OPTION] database [key]
#[OPTION] are optional flags that modify behavior
#databse is the name of the db to query
#[key] optional lookup value like username, group name, or hostname

getent -s <service> <database> [key]
#forces getent to use specific name services instead of the system default.
# This is useful when your system uses multiple sources such as local files, LDAP, or DNS

getent -s files passwd
#forces getent to return users only from local files

getent -s <database>:<service> <database [key]
# <database>:<service> specifies which db should use which service
# database is the database being queried
#[key] is an optional entry to lookup

getent -s passwd:ldap passwd gfg0913
#forces the passwd database to use ldap for the lookup

#-i or --no-idn disables idn encoding during hostname lookups. This option is useful when troubleshooting 
