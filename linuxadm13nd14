#linux access control list solves the problem with file permissions, where each file only has 1 owner and 1 group.
#acls apply more specific ownership and permissions. They let us track on access for other users or groups.

#view acls with getfacl command
getfacl /accounting

#setting an acl
setfacl [option] [action/specification] file
#action would be -m (modify) or -x (remove). Specification would be the user or group followed by the 
#permissions we want to set. In this case, we use the -d option for defaults. 

setfacl -d -m accounting:rwx /accounting 

#giving user kenny rwx access to the directory
setfacl -m kenny:rwx /accounting

#if we only want kenny to view things in /accounting and not write anything then
setfacl -m kenny:r-x /accounting

#now give kenny his own directory and add the accounting group to this directory
# sot hat accounting can view kenny's directory and keny can write to his directory

mkdir ./kenny
chown kenny:accounting ./kenny
getfacl ./kenny

#now if lets say we want everyone from accounting group to view ./kenny except fred
setfacl -m fred:- ./kenny
getfacl ./kenny

#now if we dont want anyone to see what kenny is workign on
setfacl -m g:accounting:- ./kenny
#for group acl we need to put the g:
#for users replace the g with a u

#setfacl assumes we mean user if nothing is in the spot

#now remove base permissions for groupowner so that the rest of the accounting team can't snoop into kenny's 
#reports

chmod g-rwx ./kenny

#giving ceo access to kenny's folder
useradd lisa
setfacl -m u:lisa:rwx ./kenny

#check with 
getfacl ./kenny

#even though the group owner has no permission for ./kenny, the group owner permissions remain open

