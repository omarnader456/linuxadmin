#scheduling tasks

#at command used to schedule a task to be ran at some point in the future 
#install with sudo apt install at
#tty prints the name of the terminal device connected to your standard input

echo 'echo "greeting $USER!" > /dev/pts/0' | at now + 1 minutes

# can view what at has queued with atq and view stored commands with at -c <job_number>
#at jobs run once

#the single quotes prevent the expansion of the USER variable, so 'echo "greetings $USER!" > /dev/pts/0' is sent to
#at. After 1 minutes, the at daemon executs echo "greetings $USER!" > /dev/pts/0, where the USER var is expandined.
# the output is redirected to the terminal device.

#you can schedule jobs in linux using the crontab command, which relies on the cron daemon
