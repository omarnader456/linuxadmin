#find command used to list files based on criteria
find <starting_directory> <conditions> <actions>
#example
find /home -name "*.txt"
#the command searches for all files in the home dir with a .txt extension
find /var/backups -name "home.*.tar.gz" -mtime +7 -delete
#the command search /var/backups dir for files that start with home. and end with .tar.gz
# '*' means zero or more characters
# -mtime means modification time, so +7 means 7 * 24 hours ago was the last modification
#-mmin for minutes instead of mtime for days
#-7 less than 7 days old, 7 for about 7 days old, and +7 is for more than 7 days old
#-delete deletes all files that match the condition
#can use -print to print the files that match the condition

