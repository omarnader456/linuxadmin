#Timers are systemd unti files that end in .timer; they control .service files and events. They can be used instead
#of cron. They have built in support for calendar time events, monotonic time events, and can run asynchronously.
#Timers are like other unit config files and are loaded from the same paths, but they include a [Timer]section
#that defines when and how the timer activates. 
#Timer types:
#Realtime timers: activate on calendar events, same as cronjobs do. The option OnCalendar= is used to 
#define them
#Monotonic timers: activate after a time span relative to a varying starting point. Stop if computer is 
#temporarily suspended or shutdown. There are a number of different monotonic timers but all have the form
# OnTypeSet=. Common monotonic timers include OnBootSec and OnUnitActiveSec.

#Each .timer file has a matching .service file. The .timer file activates and controls the .service file.
# The .service does not require an [Install] section as it is the timer units that are enabled.
#If necessary, it is possible to control a differently-named unit using the Unit= option
# in the timer's [Timer] section

#to use a timer unit enable and start it first.
systemctl list-timers

#systemd offers the target timers.target which sets up all timers that should be active after boot
#Use it by adding WantedBy=timers.target to the [Install] section of your timer and enable the timer unti

#fix out of sync timers by deleting stamp-* files in /var/lib/systemd/timers
#same fix for user timers, but go to ~/.local/share/systemd

#a service unit file can be scheduled with a timer out-of-the-box. 

#Example: a timer that will start 15 minutes after boot and again every week while the system is running
/etc/systemd/system/foo.timer
[Unit]
Description=Run foo weekly and on boot

[Timer]
OnBootSec=15min
OnUnitActiveSec=1w

[Install]
WantedBy=timers.target

 
#Example: a timer which starts once a week (12 am monday). When activated, it triggers the service immediately if it missed the last start time (option Persistent=true), like if the system was powered off.

/etc/systemd/system/foo.timer

[Unit]
Description=Run foo weekly

[Timer]
OnCalendar=weekly
Persistent=true

[Install]
WantedBy=timers.target


#for more specific  dates and times, OnCalender events uses the following format
DayOfWeek Year-Month-Day Hour:Minute:Second 
#asterisk may be used to specify any value and commas may be used to list possible values. .. indicates a contiguous range.

#example: run service first 4 days of the month only if that day is monday or tuesday
OnCalendar=Mon,Tue *-*-01..04 12:00:00

#example: run service on the first saturday of every month
OnCalendar=Sat *-*-1...7 18:00:00

#when using DayOfWeek, specify atleast one weekday. If you want to run something everyday at 4am:
OnCalendar=*-*-* 4:00:00

#to run services at different times,OnCalendar may be specified more than once.
#Example: run at 22:30 on weekdays and at 20:00 on weekends
OnCalendar=Mon..Fri 22:30
OnCalendar=Sat,Sun 20:00

#you can also specify a timezone at the end of the directive (using timedatectl list-timezones to list 
#accepted values)
OnCalendar=*-*-* 02:00:00 Europe/Paris

#test OnCalendar time specifications with systemd-analyze calendar weekly or systemd-analyze calendar "Mon,Tue\
# *-*-01..04 12:00:00" Add --iterations=N to ask for more iterations to be printed 

#systemd-run is used to create transient.timer units. This basically allows you to run a specified time
#without having a service file. 
#example: touch a file after 30 seconds
systemd-run --on-active=30 /bin/touch /tmp/foo

#one can specify a pre-existing service file that does not have a timer file.
#example: starting a systemd unit named someunit.service after 12.5 hours have elapsed
systemd-run --on-active="12h 30m" --unit someunit.service

#you can use template unit 
/etc/systemd/system/monthly@.timer

[Unit]
Description=Monthly Timer for %i service

[Timer]
OnCalendar=*-*-1 02:00:00
AccuracySec=6h
RandomizedDelaySec=1h
Persistent=true
Unit=%i.service

[Install]
WantedBy=default.target

#now just enable/start  monthly@unit_name.timer

#some softawre tracks the time since last run, like blocking an update to a database if the last download
#was less than 24 hours ago
#timers dont track when the task they launched has ended. To work around this, we can use OnUnitInactiveSeconds


 
/etc/systemd/system/daily-inactive@.timer

[Unit]
Description=Launch %i service 24hours after it deactivated

[Timer]
OnUnitInactiveSec=1day1sec
Unit=%i.service
Persistent=true

[Install]
WantedBy=default.target


