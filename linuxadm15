#for repos not from official sources, you can use dpkg to install deb package
# you can add a register if company provided a repo and GPG signature key

#only downloaded trusted repos

#if you downloaded a .deb file, you can use dpkg or apt to install it
dpkg -i /path/to/package/name.deb
apt install /path/to/package/name.deb

