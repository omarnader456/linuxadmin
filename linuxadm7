#apache is installed as a service - starts automatically when the server starts and keeps running 
# whether anyone is logged in or not. 

#stop server with sudo systemctl stop apache2 

sudo systemctl stop apache2

#check by typing systemctl is-active apache2
 systemctl is-active apache2
#also try using sudo systemctl status apache2
sudo systemctl status apache2
#check for Active: active (running)
