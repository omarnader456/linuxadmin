#reboot restarts the system (logs you out if using ssh)
reboot

#sudo command gives root level privileges to non-root users to run root-only commands

sudo <command>

#Global changes affect all users while local changes affects only a specific users environment

#linux has 3 user types
# root is the powerful superuser capable of executing any command
# sudoers are regular users that are able to use sudo (allowed to carry out some or all global changes)
# regular users can access the system but only perform local changes

# you can create a regular user and add it to the sudoers group

adduser <name>

# the command creates a user  with name <name> and also a group with name <name> and adds the user 
#to the group just created
#also a new home directory is created /home/<name>
# default config files from /etc/skel are copied
# asked to set password
#asks optional data like user's full name


# verify user created with id <name> which shows the uid gid and additional info

id <name>

# adding the user to the sudoers group without removing them from the groups they already are part of
sudo usermod -a -G sudo snori74

# adds user <name> to sudo group 
# the -a flag appends the user to  supplementary groups without removing existing memberships
# -G specifies supplementary group/groups

# switch to new user with su - <name>
 su - snori74

#exit returns to the original user

exit

# visudo is a command line tool used to safely edit /etc/sudoers file which controls which
# users and groups can run administrative level commands
# the command lock /etc/sudoers to prevent multiple writes 
# opens a temporary copy of the file /etc/sudoers.tmp in the systems default text editor 
#saving causes automatic syntax checks 
# syntax errors result in warnings (specifies line where error is located) -
# e reopens the file to fix problem
# x discards changes leaving original file intact
#q force saves the broken file 
# only after syntax check pass does visudo copy the temp file to /etc/sudoers

sudo EDITOR=nano visudo

#sudo visudo -f /etc/sudoers.d/custom_rules creates a file in sudoers.d directory to safely edit permission rules

sudo visudo -f /etc/sudoers.d/custom_rules

