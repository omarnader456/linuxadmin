#param can be enabled with sysctl -w net.ipv4.ip_forward=1

#to make it permanent edit /etc/sysctl.conf
#or /etc/sysctl.d/*.conf with this: net.ipv4.ip_forward = 1

#-t nat to use the nat table
#ip tables have more than one table: filter, nat, mangle, raw, security
#nat tabke is used to rewrite ports and addresses
#POSTROUTING is the chain we are appending to
#-o $EXT_IFACE means to match packets leaving through the external interface
#MASQUERADE is a special NAT TARGET (using current ip address of the outgoing interface)
# need to do this if the src is a private ip (non-routable over internet)
#MASQUERADE used instead of SNAT because allows for changing external IP, while SNAT needs fixed ip

