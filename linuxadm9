#the linux kernel has built in firewall functionality called netfilter
#utilitites on you machine interact with netfilter.
#the most low-level utility to interact with netfilter is iptables, and the newer nftables
#less complex tool is ufw
#use sudo iptables -L to check existing rules
# sudo ufw allow ssh allows ssh 
#sudo ufw deny http denies http
#explicitly allow ssh so you dont loose connection to the
# server (your using ssh to use the server's command line)
#not explicitly allowing something means that the port is automatically denied
#enable this with sudo ufw enable
#now using sudo iptables -L will show the new rules added
#sudo ufw status shows the rules
#rules also readable from /etc/ufw
#disable ufw with sudo ufw disable
#can allow specific ports and optionally specify protocol:
#sudo ufw allow <port>/<optional: protocol> (like sudo ufw allow 53/tcp)
#can also deny with the same layout as allow
#you can delete existing rules with sudo ufw delete deny 80/tcp
#ufw reads from /etc/services so you can allow or deny based on service name:
#sudo ufw allow ssh
#sudo ufw status shows if ufw enabled or not and lists rules made with the tool
#logging is enabled with sudo ufw logging on
#disable loggging with sudo ufw logging off
#can also allow access by specific ip sudo ufw allow from <ip address> 
sudo ufw allow from 192.168.1.0/24
#can allow by ip and port
sudo ufw allow from <target> to <destination> port <port number>
#can also add protocl
sudo ufw allow from <target> to <destination> port <port number> proto <protocol name>
#ping requests automatically allowed by ufw 
#to diasable ping (icmp) requests, you need to edit /etc/ufw/before.rules and remove\
# the following line:
-A ufw-before-input -p icmp --icmp-type destination-unreachable -j ACCEPT
-A ufw-before-input -p icmp --icmp-type source-quench -j ACCEPT
-A ufw-before-input -p icmp --icmp-type time-exceeded -j ACCEPT
-A ufw-before-input -p icmp --icmp-type parameter-problem -j ACCEPT
-A ufw-before-input -p icmp --icmp-type echo-request -j ACCEPT

#you can also just change the accept to drop

-A ufw-before-input -p icmp --icmp-type destination-unreachable -j DROP
-A ufw-before-input -p icmp --icmp-type source-quench -j DROP
-A ufw-before-input -p icmp --icmp-type time-exceeded -j DROP
-A ufw-before-input -p icmp --icmp-type parameter-problem -j DROP
-A ufw-before-input -p icmp --icmp-type echo-request -j DROP

#deny also supports ip, can also add port and protocol

#use sudo ufw status numbered to show id number and order of rules
#you can delete numbered rules
sudo ufw delete <number>

#you can insert a numbered rule
sudo ufw insert 1 allow from <ip address>

#for iptables the -F flag flushes a chain (removes all rules from that chain).
iptables -F OUTPUT //removes every rule currently in OUTPUT chain 

#usually flush chains before adding new rules

#iptables -A OUTPUT -m state --state ESTABLISHED -j ACCEPT

#the -A appends a rule to the chain (here chain is OUTPUT)
#-m means load a match module, where the state tracking module is the one being loaded
#now we can track whether the packet belongs to :
#NEW,ESTABLISHED,RELATED,INVALID

#ESTABLISHED allows us to match packets that are already part of an ongoing connection
#first packet with SYN flag create a connection and is in new STATE
#subsequent packets are in the ESTABLISHED state
#RELATED is, for example: FTP control connection, which creates a data connection; this
# data connection is related to the control connection
#INVALID referes to malformed or unexpected packets.
#-j (jump) is ACCEPT, so packet is allowed

#iptables -A OUTPUT -j REJECT this command rejects packet that reach here
#-j DROP differs from REJECT because DROP doesnt send a response (packet simply disappears)
# so sennder waits till timeout
#-j REJECT blocks packet and immediately sends response
#iptables check rules from top to bottom

# iptables -A INPUT -p icmp --icmp-type echo-request -j DROP
# -p here for protocol and --icmp-type specifies the particular type of icmp packet
#so basically drop all incoming ping requests.
# iptables -A OUTPUT -p tcp --dport telnet -j REJECT here we reject tcp connection to telnet port
#--dport is destination port 
# iptables -A INPUT -i lo -j ACCEPT
#-i is interface
#here accepting connections on the loopback interface
# iptables -A INPUT -p tcp -s 77.66.55.44 --dport ssh -j ACCEPT
#allow traffic from source ip 77.66.55.44 
#-s flag for source ip
# iptables -A INPUT -m mac --mac-source 00:e0:4c:f1:41:6b -p tcp --dport ssh -j ACCEPT
#here match module is mac , and we are specifying the source mac address with --mac-source
#basically allow ssh connection from source mac 00:e0:4c:f1:41:6b

